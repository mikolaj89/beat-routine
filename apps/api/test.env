DB_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require

NODE_ENV=test
HOST=0.0.0.0
PORT=8000

# Public URL where this test API will be reachable
# e.g. API_BASE_URL=https://api-test.example.com
API_BASE_URL=http://localhost:8000

# Auth / tokens
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars_for_test
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cookies
COOKIE_SAMESITE=lax
# Set these if you serve the API on HTTPS and use cross-subdomain cookies:
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

